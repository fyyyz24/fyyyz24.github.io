source "https://rubygems.org"

# Use plain Jekyll for local development. GitHub Pages builds with its own
# pinned gem set, so this file only affects local `bundle exec jekyll ...`.
gem "jekyll", "~> 4.3.0"

# Windows does not include zoneinfo files, so bundle the tzinfo-data gem
gem "tzinfo", "~> 2.0"
gem "tzinfo-data"

group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-sitemap"
  gem "jekyll-paginate"
  gem "jekyll-gist"
  gem "jekyll-redirect-from"
end
